# ---- 核心 ----
DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-32-bytes-min-random-string
ENCRYPTION_KEY=change-me-32-bytes-for-aes-gcm-b64   # 加密 OAuth token / BYOK / SMTP 授权码

# ---- 免费数据源（留空则对应适配器自动停用）----
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=
GOOGLE_MAPS_API_KEY=
COMPANIES_HOUSE_API_KEY=

# ---- 邮箱验证（自托管 Reacher，见 docs/design/04）----
REACHER_BASE_URL=http://verify-vps:8080

# ---- LLM（平台代付模式的 Key；BYOK 用户 Key 存库内加密）----
ANTHROPIC_API_KEY=
LLM_STRONG_MODEL=claude-sonnet-5
LLM_CHEAP_MODEL=claude-haiku-4-5-20251001

# ---- 发信护栏（免费版默认，勿放宽）----
SEND_DAILY_LIMIT_HEALTHY=20
SEND_DAILY_LIMIT_WARMING=5
BOUNCE_RATE_THROTTLE=0.03
COMPLAINT_RATE_PAUSE=0.001
